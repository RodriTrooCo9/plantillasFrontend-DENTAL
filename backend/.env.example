# Puerto y prefijo global del servidor NestJS
PORT=3001
API_PREFIX=api

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Conexión a PostgreSQL (Docker Compose en puerto 5433)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5433/lumina_dental?schema=public"

# Secretos y expiración JWT
JWT_SECRET="lumina-dental-super-secret-jwt-key-2026"
JWT_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=7

# Zona horaria clínica oficial
CLINIC_TIME_ZONE="America/Mexico_City"
