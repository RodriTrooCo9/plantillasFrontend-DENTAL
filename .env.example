# Adaptador: mock para demostración, http para NestJS.
NEXT_PUBLIC_DATA_SOURCE="mock"

# Solo servidor: el navegador utiliza /api/backend en el mismo origen.
API_URL="http://localhost:4000/api/v1"

# Debe coincidir con la zona horaria de la clínica configurada en NestJS.
NEXT_PUBLIC_CLINIC_TIME_ZONE="America/Mexico_City"
