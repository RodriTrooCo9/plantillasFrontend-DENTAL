# Adaptador: http para conectar al backend NestJS real, mock para demostración/tests.
NEXT_PUBLIC_DATA_SOURCE="http"

# URL pública del backend NestJS (puerto 3001 y prefijo global /api).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# URL del backend NestJS consumida por el servidor Next.js y el proxy BFF (/api/backend).
API_URL="http://localhost:3001/api"

# Debe coincidir con la zona horaria de la clínica configurada en NestJS.
NEXT_PUBLIC_CLINIC_TIME_ZONE="America/Mexico_City"
